# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=noma
POSTGRES_USER=noma
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
DATABASE_URL=

# ── First-run owner account ─────────────────────────────────────────────────
# Paste this token on the setup screen to create the first administrator.
SETUP_TOKEN=

# ── Mail engine ─────────────────────────────────────────────────────────────
# The CMS runs its own mail server. There is no external SMTP relay to set up.
# Application email (OTP, order receipts) is sent from no-reply@<your domain>
# once a domain and mailbox exist under Studio → Mail. Leave these at their
# defaults unless you must move a port.
MAIL_SMTP_PORT=25
MAIL_SUBMISSION_PORT=587
MAIL_SMTPS_PORT=465
MAIL_IMAP_PORT=143
MAIL_IMAPS_PORT=993
MAIL_POP3_PORT=110
MAIL_POP3S_PORT=995
# Signs webmail session cookies. Set to a long random string in production.
MAIL_SESSION_SECRET=

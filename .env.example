# One PostgreSQL connection URL is the only database setting.
# Bundled Docker example (do not use host 127.0.0.1 inside the app container):
DATABASE_URL=postgresql://rayomand:replace-with-a-long-random-password@postgres:5432/rayomand
# Bare metal / external PostgreSQL example:
# DATABASE_URL=postgresql://rayomand:replace-with-a-long-random-password@127.0.0.1:5432/rayomand

# First-run owner creation only. Generate with: openssl rand -hex 32
SETUP_TOKEN=

# Permanent webmail cookie-signing secret and primary encryption key for mail
# settings. Generate separately with: openssl rand -hex 32
MAIL_SESSION_SECRET=

# Optional advanced override for mail-secret encryption only. Normally leave
# unset so MAIL_SESSION_SECRET is used.
# MAIL_SECRET_KEY=

# Optional host web port for standalone Docker (default 3131). Coolify does
# not use this variable because Traefik routes to the internal port.
WEB_PORT=3131

# Docker sets MAIL_DATA_DIR=/app/data/mail. Bare metal defaults to ./data/mail.
# MAIL_DATA_DIR=/var/lib/rayomand/mail

# The built-in mail server uses these defaults. Change both the internal port
# and any host mapping together when a port is already occupied.
MAIL_SMTP_PORT=25
MAIL_SUBMISSION_PORT=587
MAIL_SMTPS_PORT=465
MAIL_IMAP_PORT=143
MAIL_IMAPS_PORT=993
MAIL_POP3_PORT=110
MAIL_POP3S_PORT=995
